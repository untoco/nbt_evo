#!/bin/bash
set -euo pipefail
repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
action="${1:-help}"
if [ "$#" -gt 0 ]; then shift; fi
case "$action" in
    setup) ;;
    check) set -- --tags verify "$@" ;;
    plan) set -- --list-tasks "$@" ;;
    help|--help|-h)
        printf 'Usage: tools/nbt-env {setup|check|plan} [ansible-playbook options]\n'
        exit 0 ;;
    *) printf 'Unknown action: %s\n' "$action" >&2; exit 2 ;;
esac
if ! command -v ansible-playbook >/dev/null; then
    printf 'ansible-playbook is required on the prepared Mac.\n' >&2
    exit 1
fi
mkdir -p "$repo_dir/.build/bootstrap/ansible-tmp"
log_name="$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
export ANSIBLE_LOG_PATH="$repo_dir/.build/bootstrap/$log_name"
export ANSIBLE_LOCAL_TEMP="$repo_dir/.build/bootstrap/ansible-tmp"
ln -sfn "$log_name" "$repo_dir/.build/bootstrap/latest.log"
printf 'Log: %s\n' "$ANSIBLE_LOG_PATH"
exec ansible-playbook -i localhost, "$repo_dir/automation/ansible/environment.yml" "$@"
